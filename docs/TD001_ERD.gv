// Graphviz dot language
// TD001_ERD - Entity Relationship Diagram

digraph G {
	graph [layout=dot rankdir=TD]
	node [shape=box]

	//Loader -> Shape
	
	//BufObj -> {VAO EBO VBO} [arrowtail=onormal, dir=back, label="is a"]
	
	Loader -> {VAO Shape} [label="creates"]
	
	VAO -> {EBO VBO} [label="creates"]


	// Variables/properties
	node [shape=plain]
	VBOBuffer -> VBO
	{Vertices TexCoords Normals} -> Loader

	// Functions/processes for classes
	node [shape=oval]
	"vao.update()" -> "finalizePoints<T>()"
	
	CodeShape
	ObjShape
}
